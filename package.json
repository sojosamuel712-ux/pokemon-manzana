{
  "name": "manzanap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "npm --prefix backend start",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "admin:create": "npm --prefix backend run admin:create --",
    "start": "npm run server",
    "build": "vite build",
    "lint": "oxlint --ignore-pattern src/App.backup.jsx",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
